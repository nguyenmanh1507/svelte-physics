		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.5.0",
		"@types/prismjs": "^1.26.6",
		"@types/stats.js": "^0.17.4",
		"@types/three": "^0.186.0",
		"@vitest/browser-playwright": "^4.1.0",
		"bits-ui": "^2.20.1",
		"clsx": "^2.1.1",
		"daisyui": "^5.7.50",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"postcss": "^8.5.31",
		"postcss-preset-env": "^11.6.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "3.5.1",
